# ---- SEEK employer portal credentials ----
# Your SEEK employer-portal login. Fill these in (do NOT commit real values).
SEEK_EMAIL=
SEEK_PASSWORD=
SEEK_BASE_URL=https://th.employer.seek.com
# Which employer account to scrape (number on the "Select an account" page).
# Blank = first listed account.
ADVERTISER_ID=

# ---- Local SQL Server (run the scraper natively on Windows) ----
# DB_HOST: leave blank -> 'localhost' on Windows. Set e.g. localhost or a host IP.
DB_HOST=localhost
# DB_INSTANCE: set to your named instance if you use one (e.g. SQLEXPRESS).
# Leave blank for the default instance. When set, DB_PORT is ignored.
DB_INSTANCE=
DB_PORT=1433
DB_NAME=jobdb_scraping

# Authentication:
#   Windows Authentication (recommended, simplest) -> leave DB_USER blank,
#     or set DB_TRUSTED=yes. No TCP/firewall/sa setup needed for a local server.
#   SQL Server Authentication -> set DB_USER + DB_PASSWORD (and DB_TRUSTED=no).
DB_TRUSTED=yes
DB_USER=
DB_PASSWORD=

# ODBC driver name as installed on Windows (Driver 18 is present on this machine)
DB_DRIVER=ODBC Driver 18 for SQL Server

# ---- Scraper behaviour ----
# Where resume/CV files are saved. Leave blank to use <project>\resume.
# On Windows use a Windows path, e.g. E:\jobdb_scraping\resume
RESUME_DIR=
# Base OneDrive folder where candidate sub-folders (Shortlists/, Email_Reply_Exam/)
# are stored, synced and shareable.
# LEAVE BLANK to auto-detect: the app uses Windows' own OneDrive location for whoever
# is logged in + "Recruit's files - Recruitment\Recruite_Scraping", so each teammate's
#   C:\Users\<them>\OneDrive - freewillsolutions.com\Recruit's files - Recruitment\Recruite_Scraping
# resolves automatically. Set this ONLY if your synced library lives somewhere else
# (you'll see a "OneDrive base folder not found" warning at startup if so).
# (SHORTLIST_DIR / REPLY_EXAM_DIR below override individual subfolders if you'd rather.)
ONEDRIVE_BASE=
# Where per-shortlist resume folders are created (put it in OneDrive so the folder
# can be shared; its name goes into the shortlist email's "Link document:" line).
# Leave blank to use the default OneDrive\Shortlists path.
SHORTLIST_DIR=
# OneDrive-relative folder (under the SIGNED-IN Recruit account's drive root) where
# résumés are uploaded via Graph for the auto share link. MUST be the same physical
# folder you see locally under SHORTLIST_DIR. Default: Recruitment/Recruite_Scraping/Shortlists
SHORTLIST_ONEDRIVE_DIR=
# Seconds (min,max) of random delay between page actions to stay polite
DELAY_MIN=1.0
DELAY_MAX=2.5

# ---- Exam email via Microsoft Graph (for the web UI) ----
# Single shared "Recruit" delegated app, signed in ONCE on the Config Email Template
# page (device-code flow; no client secret used). It sends the exam, creates the
# drafts/events for Shortlist/Interview/Evaluation/Offer, and detects replies. Needs
# DELEGATED Mail.ReadWrite, Calendars.ReadWrite, Files.ReadWrite, User.Read + public-
# client flow. Client/tenant IDs are not secrets; working defaults are baked into
# config.py, so set these only to point at a DIFFERENT app.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Mailbox the exam is sent FROM (the shared mailbox you sign in as); informational.
GRAPH_SENDER=

# ---- Recruiter signature (PER TEAMMATE) ----
# Each teammate sets their own identity so emails sent/drafted from THIS machine sign
# as them, even though the Recruit mailbox is shared. Used in the signature block of
# exam/shortlist/evaluation/offer emails (the {signature} placeholder) and the Thai
# offer body. Leave any blank to fall back to the built-in default.
RECRUITER_NAME=
# First name only (used in the Thai offer body "ความเห็นฝ่าย Recruit")
RECRUITER_FIRSTNAME=
RECRUITER_MOBILE=
RECRUITER_TEL=
RECRUITER_EMAIL=

# Exam email content. {name} is replaced with the candidate's name.
EXAM_SUBJECT=Pre-employment exam invitation
EXAM_BODY=Dear {name},\n\nThank you for applying. Please complete the attached exam and reply with your answers.\n\nBest regards,\nRecruitment Team
# Path to the exam file to attach (optional). e.g. E:\jobdb_scraping\exam\exam.pdf
EXAM_ATTACHMENT=
